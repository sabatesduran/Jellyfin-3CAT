<Project>
  <PropertyGroup>
    <Version>1.14.0.0</Version>
    <AssemblyVersion>1.14.0.0</AssemblyVersion>
    <FileVersion>1.14.0.0</FileVersion>
    <ThreeCatTargetFramework Condition="'$(ThreeCatTargetFramework)' == ''">net9.0</ThreeCatTargetFramework>
    <ThreeCatJellyfinVersion Condition="'$(ThreeCatJellyfinVersion)' == ''">10.11.6</ThreeCatJellyfinVersion>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
